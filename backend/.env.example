# OpenAI API key — used for both embeddings and chat
OPENAI_API_KEY=

# Chat model for answering and question condensing (default: gpt-5.6-sol)
OPENAI_MODEL=gpt-5.6-sol

# Optional: model for the per-turn query parser (default: same as OPENAI_MODEL). A smaller/faster model works well here.
# OPENAI_PARSER_MODEL=

# Embedding model (default: text-embedding-3-small).
# Must match the model the FAISS index was built with; after changing it, rebuild: python -m scripts.build_index
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Supabase project URL, e.g. https://xxxx.supabase.co (backend fetches the JWKS from it to verify user JWTs)
SUPABASE_URL=

# Optional: comma-separated frontend origins allowed by CORS (default: http://localhost:3000)
# ALLOWED_ORIGINS=http://localhost:3000
